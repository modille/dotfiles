# Mirrors ~/.zshenv and ~/.zshrc, minus what needs zsh plugins (autosuggestions,
# syntax highlighting, abbreviations; the latter become aliases below).

[[ -f $HOME/.cargo/env ]] && source $HOME/.cargo/env

# Build flags from homebrew caveats, as in ~/.zshenv
for keg in curl libffi libiconv libpq mysql@8.0 mysql@8.4 sqlite; do
  keg=/opt/homebrew/opt/$keg
  [[ -d $keg ]] || continue
  # Shells started from another shell inherit its flags, so append only once
  [[ " $LDFLAGS " == *" -L$keg/lib "* ]] || export LDFLAGS="${LDFLAGS:+$LDFLAGS }-L$keg/lib"
  [[ " $CPPFLAGS " == *" -I$keg/include "* ]] || export CPPFLAGS="${CPPFLAGS:+$CPPFLAGS }-I$keg/include"
  [[ ! -d $keg/lib/pkgconfig || ":$PKG_CONFIG_PATH:" == *":$keg/lib/pkgconfig:"* ]] ||
    export PKG_CONFIG_PATH="${PKG_CONFIG_PATH:+$PKG_CONFIG_PATH:}$keg/lib/pkgconfig"
done
unset keg

[[ $- == *i* ]] || return

# devbox puts nix's minimal bash (no readline or programmable completion) first on PATH
if ! shopt -q progcomp 2>/dev/null && [[ -x /opt/homebrew/bin/bash ]]; then
  exec /opt/homebrew/bin/bash
fi

# Source the output of `<cmd> init`-style commands from a cache, regenerating
# it whenever the binary changes (a Homebrew upgrade changes the resolved path).
_cached_eval() {
  local bin
  bin=$(type -P "$1") || return
  bin=$(realpath "$bin")
  local args="$*"
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/bash-eval/${bin//\//_}_${args#* }
  cache=${cache// /_}
  if [[ ! -s $cache || $bin -nt $cache ]]; then
    mkdir -p "${cache%/*}" && "$@" >|"$cache"
  fi
  source "$cache"
}

# PATH, deduplicated like zsh's `typeset -U path`
PATH=$HOME/.bun/bin:$HOME/.cargo/bin:$HOME/.local/bin:/nix/var/nix/profiles/default/bin:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH
export BUN_INSTALL=$HOME/.bun
[[ -f $HOME/.vite-plus/env ]] && source $HOME/.vite-plus/env

# From homebrew caveats (their build flags are above)
for keg in curl libffi libiconv libpq mysql@8.0 mysql@8.4 sqlite; do
  [[ -d /opt/homebrew/opt/$keg/bin ]] && PATH=/opt/homebrew/opt/$keg/bin:$PATH
done
unset keg

# bash-completion@2, before anything that registers completions
[[ -r /opt/homebrew/etc/profile.d/bash_completion.sh ]] && source /opt/homebrew/etc/profile.d/bash_completion.sh

_dedupe_path() {
  local IFS=: dir out=
  for dir in $PATH; do
    [[ :$out: == *:"$dir":* ]] || out+=${out:+:}$dir
  done
  PATH=$out
}
_dedupe_path
export PATH

export DIRENV_LOG_FORMAT=""
export EDITOR=nvim
export LESS=" -R"
export MANPAGER='env NVIM_PROFILE=man nvim +Man!'

# Derive bat and lazygit themes from the mode change_background records
_bg_state=$HOME/.local/state/modille/current_background_mode.txt
[[ -r $_bg_state ]] && _bg_mode=$(<$_bg_state)
export BAT_THEME="Solarized (${_bg_mode:=light})" LG_CONFIG_FILE=$HOME/.config/lazygit/${_bg_mode}_config.yml
unset _bg_state _bg_mode

# History, shared across sessions (vi mode and key bindings live in ~/.inputrc)
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT='%F %T '
shopt -s histappend autocd
PROMPT_COMMAND="history -a; history -n${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# Fish's built-in ls/ll/la: color, plus type indicators when writing to a terminal
ls() {
  if [[ -t 1 ]]; then command ls --color=auto -F "$@"; else command ls --color=auto "$@"; fi
}
alias ll="ls -lh" la="ls -lAh"

alias brew_refill="brew update && brew outdated && brew upgrade && brew cleanup && brew doctor"
# cat with syntax highlighting
alias cats="highlight --out-format xterm256 --quiet --force --style solarized-light --"
# common typo
alias gits="git s"
alias xit=exit

# zsh-abbr abbreviations (lines look like: abbr "gs"="git status"), defined as
# aliases and expanded in command position on Space or Enter
declare -A _abbrs
if [[ -r $HOME/.config/zsh-abbr/user-abbreviations ]]; then
  while IFS= read -r line; do
    [[ $line == abbr\ * ]] || continue
    eval "alias ${line#abbr }"
    line=${line#abbr \"}
    _abbrs[${line%%\"=*}]=1
  done <$HOME/.config/zsh-abbr/user-abbreviations
  unset line
fi

_abbr_expand() {
  local left=${READLINE_LINE:0:READLINE_POINT}
  local word=${left##*[[:space:];&|]}
  local prefix=${left%"$word"}
  [[ -n $word && -n ${_abbrs[$word]} && $prefix =~ (^|[;&|])[[:space:]]*$ ]] || return
  READLINE_LINE=$prefix${BASH_ALIASES[$word]}${READLINE_LINE:READLINE_POINT}
  READLINE_POINT=$((${#prefix} + ${#BASH_ALIASES[$word]}))
}
_abbr_space() {
  _abbr_expand
  READLINE_LINE="${READLINE_LINE:0:READLINE_POINT} ${READLINE_LINE:READLINE_POINT}"
  ((READLINE_POINT++))
}
bind -m vi-insert -x '" ": _abbr_space'
for keymap in vi-insert vi-command; do
  bind -m $keymap -x '"\C-x\C-a": _abbr_expand'
  bind -m $keymap '"\C-x\C-b": accept-line'
  bind -m $keymap '"\C-m": "\C-x\C-a\C-x\C-b"'
done
unset keymap

# cd to "git root"
grt() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) && cd "$root"
}

# git get a repo and cd into it
gg() {
  if ((!$#)); then
    echo "[gg] usage: gg <github-url-or-path>"
    return 1
  fi

  # Strip protocol if present
  local input=${1#http://}
  input=${input#https://}

  # Take only host/owner/repo (first 3 path segments)
  local -a parts
  IFS=/ read -ra parts <<<"$input"
  if ((${#parts[@]} < 3)); then
    echo "[gg] expected at least host/owner/repo, got: $input"
    return 1
  fi
  local repo_path=${parts[0]}/${parts[1]}/${parts[2]}

  git get "$repo_path" || return 1

  cd ~/git/"$repo_path"
}

# Port of ~/.config/zsh/functions/change_background
change_background() {
  local mode=light
  case $1 in
  '')
    defaults read -g AppleInterfaceStyle &>/dev/null && mode=dark
    ;;
  light | dark)
    local dark=false
    [[ $1 == dark ]] && dark=true
    osascript -l JavaScript -e "Application('System Events').appearancePreferences.darkMode = $dark" >/dev/null
    mode=$1
    ;;
  esac

  # bat, lazygit (set before the early return below)
  export BAT_THEME="Solarized ($mode)" LG_CONFIG_FILE=$HOME/.config/lazygit/${mode}_config.yml

  # Tracks the current mode in a file, and only proceed if the new mode is different than the current mode
  local state_file=$HOME/.local/state/modille/current_background_mode.txt
  mkdir -p "${state_file%/*}"
  [[ -e $state_file ]] || echo $mode >"$state_file"
  [[ $mode == $(<"$state_file") ]] && return
  echo $mode >"$state_file"

  # Neovim (bgwinch.nvim)
  pkill -WINCH nvim
}

_cached_eval zoxide init bash
_cached_eval wt config shell init bash
_cached_eval starship init bash --print-full-init
# Each hook prepends itself to PROMPT_COMMAND, so mise goes last for direnv's
# (devbox's) versions to win, as with zsh's precmd order
_cached_eval direnv hook bash
_cached_eval mise activate bash
